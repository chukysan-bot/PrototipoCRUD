@model PrototipoCRUD.Controllers.ReporteVentasViewModel
@{
    ViewData["Title"] = "Reporte de Ventas y Cobranzas";
}

<style>
    @@media print {
        .no-print { display: none !important; }
        body { background: #fff !important; }
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Reporte de Ventas y Cobranzas</h2>
            <small class="text-muted">
                Rango: @Model.FechaInicio.ToString("yyyy-MM-dd") al @Model.FechaFin.ToString("yyyy-MM-dd") |
                Granularidad: <strong>@Model.Granularidad</strong> |
                Emitido: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")
            </small>
        </div>
        <button type="button" class="btn btn-secondary no-print" onclick="window.print()">
            Imprimir / Guardar PDF
        </button>
    </div>

    <form method="get" asp-action="Index" class="row g-3 mb-4 no-print">
        <div class="col-md-3">
            <label class="form-label">Fecha Inicio</label>
            <input type="date" name="fechaInicio" class="form-control" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Fecha Fin</label>
            <input type="date" name="fechaFin" class="form-control" value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Granularidad</label>
            <select name="granularidad" class="form-select">
                <option value="Diario" selected="@(Model.Granularidad == "Diario")">Diario</option>
                <option value="Mensual" selected="@(Model.Granularidad == "Mensual")">Mensual</option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Generar Reporte</button>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeAviso))
    {
        <div class="alert alert-warning" role="alert">
            @Model.MensajeAviso
        </div>
    }
    else
    {
        foreach (var grupo in Model.Grupos)
        {
            <div class="card mb-4">
                <div class="card-header bg-light fw-bold">@grupo.NombreGrupo</div>
                <div class="card-body p-0">
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-secondary">
                            @if (Model.Granularidad == "Mensual")
                            {
                                <tr>
                                    <th>Fecha Día</th>
                                    <th>Cantidad Ventas</th>
                                    <th class="text-end">Total Descuentos</th>
                                    <th class="text-end">Total Cobrado</th>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <th>Nro Venta / Hora</th>
                                    <th>Cliente</th>
                                    <th>Vendedor</th>
                                    <th class="text-end">Descuento</th>
                                    <th class="text-end">Total Cobrado</th>
                                </tr>
                            }
                        </thead>
                        <tbody>
                            @foreach (var fila in grupo.Filas)
                            {
                                if (Model.Granularidad == "Mensual")
                                {
                                    <tr>
                                        <td>@fila.Col1</td>
                                        <td>@fila.Col2</td>
                                        <td class="text-end">@fila.Descuento.ToString("N2")</td>
                                        <td class="text-end">@fila.TotalCobrado.ToString("N2")</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td>@fila.Col1</td>
                                        <td>@fila.Col2</td>
                                        <td>@fila.Col3</td>
                                        <td class="text-end">@fila.Descuento.ToString("N2")</td>
                                        <td class="text-end">@fila.TotalCobrado.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-info fw-bold">
                            <tr>
                                <td colspan="@(Model.Granularidad == "Mensual" ? 2 : 3)">
                                    Subtotal grupo (Operaciones: @grupo.SubtotalOperaciones)
                                </td>
                                <td class="text-end">@grupo.SubtotalDescuentos.ToString("N2")</td>
                                <td class="text-end">@grupo.SubtotalCobrado.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }

        <div class="card border-dark">
            <div class="card-body d-flex justify-content-between fw-bold">
                <span>GRAN TOTAL DEL PERIODO (Operaciones: @Model.GranTotalOperaciones)</span>
                <span>
                    Descuentos: @Model.GranTotalDescuentos.ToString("N2")  | 
                    Total Cobrado: @Model.GranTotalCobrado.ToString("N2")
                </span>
            </div>
        </div>
    }
</div>